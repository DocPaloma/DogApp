<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".view.detail.DetailAppointmentFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOOLBAR / HEADER SUPERIOR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerDetalleCita"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_header_new_cita"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnReturnDetail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:src="@drawable/return_shape_header"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitleDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_bold"
                android:text="Detalle de la Cita"
                android:textColor="@color/white"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ESPACIO PARA LA TARJETA DE IMAGEN SUPERPUESTA -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-30dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- TARJETA SUPERIOR: IMAGEN DE LA MASCOTA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPetImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                android:layout_gravity="center_horizontal|top"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/ivPetPhoto"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/ic_dog_head"
                        android:scaleType="centerCrop"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- TARJETA INFERIOR: INFORMACIÓN -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-20dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TURNO - Arriba derecha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tvTurnNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_500"
                        android:fontFamily="@font/fredoka_bold"/>
                </LinearLayout>

                <!-- RAZA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Raza"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/fredoka_regular"/>

                <TextView
                    android:id="@+id/tvPetBreed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/fredoka_regular"/>

                <!-- SÍNTOMAS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Síntomas"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/fredoka_regular"/>

                <TextView
                    android:id="@+id/tvSymptoms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/fredoka_regular"/>

                <!-- LÍNEA ROSADA -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#F05861"/>

                <!-- PROPIETARIO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Propietario"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/fredoka_regular"/>

                <TextView
                    android:id="@+id/tvOwnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/fredoka_regular"/>

                <!-- TELÉFONO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/fredoka_regular"/>

                <TextView
                    android:id="@+id/tvOwnerPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/fredoka_regular"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
