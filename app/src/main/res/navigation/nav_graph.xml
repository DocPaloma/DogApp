<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.dogapp.view.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.dogapp.view.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_homeFragment_to_newAppointmentFragment"
            app:destination="@id/newAppointmentFragment" />
        <action
            android:id="@+id/action_homeFragment_to_detailAppointmentFragment"
            app:destination="@id/detailAppointmentFragment" />
    </fragment>

    <fragment
        android:id="@+id/newAppointmentFragment"
        android:name="com.example.dogapp.view.create.NewAppointmentFragment"
        android:label="Nueva Cita" />

    <fragment
        android:id="@+id/detailAppointmentFragment"
        android:name="com.example.dogapp.view.detail.DetailAppointmentFragment"
        android:label="Detalle de la Cita"
        tools:layout="@layout/fragment_detail_appointment">
        <action
            android:id="@+id/action_detailAppointmentFragment_to_editAppointmentFragment"
            app:destination="@id/editAppointmentFragment" />
    </fragment>

    <fragment
        android:id="@+id/editAppointmentFragment"
        android:name="com.example.dogapp.view.edit.EditAppointmentFragment"
        android:label="Editar Cita"
        tools:layout="@layout/fragment_edit_appointment">
        <action
            android:id="@+id/action_editAppointmentFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
